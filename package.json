{
  "name": "breck-open",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "pnpm run typecheck && vite build",
    "test": "vitest run",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "mobile": "npm --prefix apps/mobile start",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck"
  },
  "dependencies": {
    "mapbox-gl": "^3.30.0",
    "motion": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
